{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for DailySnap windows",
  "windows": ["main", "float-ball", "mini-chat"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "notification:default",
    "os:default",
    "autostart:default",
    "clipboard-manager:default"
  ]
}