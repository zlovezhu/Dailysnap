# DailySnap 中转服务配置（复制成 .env 后填实际值）
#
# 重要：.env 不要 commit 到 git！
# 部署时第一次跑前先执行：
#   sudo cp .env.example .env
#   sudo nano .env
# 然后填下面的值

# 中转服务自己的 token（客户端用这个鉴权）
# 生成建议：openssl rand -hex 32
RELAY_TOKEN=replace-me-with-a-long-random-token

# DeepSeek API key（在 deepseek 平台充值后获取）
DEEPSEEK_API_KEY=sk-replace-me-with-your-deepseek-key

# DeepSeek base URL（OpenAI 兼容协议）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型
DEEPSEEK_MODEL=deepseek-v4-flash